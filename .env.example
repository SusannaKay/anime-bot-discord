# Copy this file to .env and fill in your values.

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=your-bot-token-here

# ID of the channel where rounds are posted.
# Discord: Settings -> Advanced -> Developer Mode, then right click the channel -> Copy Channel ID.
ROUND_CHANNEL_ID=123456789012345678

# Optional settings (defaults shown).
# DB_PATH=bot.db
# ROUND_MIN_DELAY_MINUTES=5
# ROUND_MAX_DELAY_MINUTES=30
# ROUND_TIMEOUT_MINUTES=10
